      <a class="link" href="https://t.me/luvbalenc" target="_blank" rel="noopener"><span class="icon">➤</span><span><span class="label">Telegram</span><span class="sub">Новини та спілкування</span></span></a>
      <a class="link" href="https://www.tiktok.com/@luv_linaaaa_" target="_blank" rel="noopener"><span class="icon">♪</span><span><span class="label">TikTok</span><span class="sub">Кліпи та короткі відео</span></span></a>
      <a class="link donate" href="https://linatwich.donatik.ua/" target="_blank" rel="noopener"><span class="icon">♥</span><span><span class="label">Донат</span><span class="sub">Підтримай мене на стрімі 💖</span></span></a>
    </nav>
    <footer>✧ ДЯКУЮ, ЩО ТИ ТУТ ✧</footer>
  </main>
</body>
</html>
